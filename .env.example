# Copy to .env and fill in. Never commit .env.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
SECAUDIT_APP_USER=secaudit_app
SECAUDIT_APP_PASSWORD=change-me

SECAUDIT_ENV=dev
SECAUDIT_MONGO_URI=mongodb://secaudit_app:change-me@localhost:27017/secaudit?authSource=secaudit
SECAUDIT_MONGO_TLS=false
SECAUDIT_CORS_ORIGINS=["http://localhost:5173"]
