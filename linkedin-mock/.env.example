# Copy to .env and change the passwords. Use URL-safe characters (letters, digits, - _)
# because the app password is embedded in the MongoDB connection URI.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_DB=linkedin_mock
MONGO_APP_USER=linkedin_app
MONGO_APP_PASSWORD=change-me-app
SEED_DATA=true
